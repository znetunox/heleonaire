{
  "name": "Heleonaire",
  "version": "1.0.0",
  "description": "Heleonaire MMORPG Monorepo",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev:server": "pnpm --filter @heleonaire/server dev",
    "dev:client": "pnpm --filter @heleonaire/client dev",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "build:shared": "pnpm --filter @heleonaire/shared build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
