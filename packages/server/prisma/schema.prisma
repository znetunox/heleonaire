generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// ACCOUNT / PLAYER
// ============================================================

model Account {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters Character[]

  @@map("accounts")
}

model Character {
  id        String @id @default(uuid())
  accountId String

  name String @unique

  // Custom Heleonaire class key.
  // Example: knight, assassin, archer, mage, cleric
  classKey String

  jobKey String

  // Current faction.
  faction String

  // Progression
  level    Int @default(1)
  jobLevel Int @default(1)

  baseExp BigInt @default(0)
  jobExp  BigInt @default(0)

  availablePoints      Int @default(0)
  availableSkillPoints Int @default(0)

  // Primary stats
  str Int @default(1)
  agi Int @default(1)
  vit Int @default(1)
  int Int @default(1)
  dex Int @default(1)
  luk Int @default(1)

  // Resources
  hp    Int @default(100)
  maxHp Int @default(100)
  mp    Int @default(50)
  maxMp Int @default(50)

  // World position
  mapId String @default("plains_of_ash")
  posX  Float  @default(200)
  posY  Float  @default(200)
  posZ  Float  @default(0)

  gold BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  inventory Inventory[]
  equipment CharacterEquipment[]
  skills    CharacterSkill[]

  @@index([accountId])
  @@index([mapId])
  @@map("characters")
}

// ============================================================
// SIZE FIX RULES
// ============================================================

model SizeFixRule {
    id         Int      @id @default(autoincrement())
    weaponType String   @unique
    small      Int      @default(100)
    medium     Int      @default(100)
    large      Int      @default(100)
    source     String   @default("rathena")
    sourceHash String?
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id String @id @default(uuid())

  characterId String
  itemId      Int

  quantity Int @default(1)

  slot Int @default(-1)

  // Unique instance when an item needs individual identity.
  // 0 means normal stackable/static item.
  instanceId String?

  refineLevel Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([characterId])
  @@index([characterId, slot])
  @@index([itemId])
  @@map("inventory")
}

// ============================================================
// EQUIPMENT
// ============================================================

model CharacterEquipment {
  id String @id @default(uuid())

  characterId String
  itemId      Int

  // Logical equipment location.
  // Example:
  // weapon, shield, head_top, armor, shoes, accessory_left...
  slot String

  inventoryId String?

  refineLevel Int @default(0)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([characterId, slot])
  @@index([itemId])
  @@map("character_equipment")
}

// ============================================================
// ITEMS
// ============================================================

model Item {
  id Int @id

  aegisName String @unique
  name      String

  type    String
  subType String?

  buy  Int @default(0)
  sell Int @default(0)

  weight Int @default(0)

  attack      Int?
  magicAttack Int?
  defense     Int?

  range Int?
  slots Int?

  weaponLevel Int?
  armorLevel  Int?

  equipLevelMin Int?
  equipLevelMax Int?

  refineable Boolean @default(false)
  gradable   Boolean @default(false)

  // rAthena equipment restrictions
  jobs      String?
  job       String?
  classes   String?
  gender    String?
  locations String?

  // Visual / identification
  view      Int?
  aliasName String?

  // rAthena scripts
  script        String?
  equipScript   String?
  unequipScript String?

  // rAthena item flags / rules
  flags String?
  noUse String?
  trade String?
  stack String?
  delay String?

  // Legacy/common item flags
  buyingStore Boolean @default(false)
  deadBranch  Boolean @default(false)
  container   Boolean @default(false)
  uniqueId    Boolean @default(false)
  sitting     Boolean @default(false)

  // Import/source information
  source     String  @default("rathena")
  sourceHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory      Inventory[]
  equipment      CharacterEquipment[]
  drops          DropEntry[]
  skillItemCosts SkillRequirementItem[]
  comboEntries   ItemComboEntry[]
  refineChanceMaterials RefineChance[] @relation("RefineChanceMaterial")

  @@index([type])
  @@index([subType])
  @@index([name])
  @@map("items")
}

// ============================================================
// RATHENA REFINE RULES
// ============================================================

model RefineRule {
  id Int @id @default(autoincrement())

  group       String
  itemLevel   Int
  refineLevel Int

  bonus       Int @default(0)
  randomBonus Int @default(0)

  blacksmithBlessingAmount Int @default(0)

  broadcastSuccess Boolean @default(false)
  broadcastFailure Boolean @default(false)

  source     String  @default("rathena")
  sourceHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chances RefineChance[]

  @@unique([group, itemLevel, refineLevel])
  @@index([group])
  @@index([group, itemLevel])
  @@map("refine_rules")
}

model RefineChance {
  id Int @id @default(autoincrement())

  refineRuleId Int

  type String

  rate Int @default(0)
  price Int @default(0)

  materialItemId Int?

  breakingRate Int @default(0)
  downgradeAmount Int @default(0)

  refineRule RefineRule @relation(fields: [refineRuleId], references: [id], onDelete: Cascade)

  material Item? @relation("RefineChanceMaterial", fields: [materialItemId], references: [id], onDelete: Restrict)

  @@unique([refineRuleId, type])
  @@index([refineRuleId])
  @@index([materialItemId])
  @@map("refine_chances")
}

// ============================================================
// MONSTERS
// ============================================================

model Mob {
  id Int @id

  aegisName String @unique
  name      String

  level Int @default(1)

  hp Int @default(1)
  sp Int @default(1)

  baseExp Int @default(0)
  jobExp  Int @default(0)

  attack  Int @default(0)
  attack2 Int @default(0)

  defense      Int @default(0)
  resistance   Int @default(0)
  magicDefense Int @default(0)

  str Int @default(1)
  agi Int @default(1)
  vit Int @default(1)
  int Int @default(1)
  dex Int @default(1)
  luk Int @default(1)

  attackRange Int @default(1)
  skillRange  Int @default(10)
  chaseRange  Int @default(12)

  size String @default("Small")
  race String @default("Formless")

  element      String @default("Neutral")
  elementLevel Int    @default(1)

  walkSpeed    Int @default(200)
  attackDelay  Int @default(2000)
  attackMotion Int @default(720)
  damageMotion Int @default(480)

  ai String @default("01")

  // Import/source information
  source     String  @default("rathena")
  sourceHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drops DropEntry[]

  @@index([level])
  @@index([race])
  @@index([element])
  @@map("mobs")
}

// ============================================================
// MONSTER DROPS
// ============================================================

model DropEntry {
  id String @id @default(uuid())

  mobId  Int
  itemId Int

  // rAthena usa valores como 100 = 1%
  rate Int

  stealProtected Boolean @default(false)

  // Identifica deterministicamente a entrada original do rAthena.
  // Ex.: rathena:1002:0
  sourceKey String? @unique

  mob  Mob  @relation(fields: [mobId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([mobId])
  @@index([itemId])
  @@index([mobId, itemId])
  @@map("mob_drops")
}

// ============================================================
// SKILLS
// ============================================================

model Skill {
  id                   Int      @id
  aegisName            String   @unique
  description          String?
  maxLevel             Int      @default(1)
  type                 String?
  targetType           String?
  hit                  String?
  damageFlags          String?
  flags                String?
  range                Int      @default(0)
  castCancel           Boolean  @default(true)
  castDefenseReduction Int      @default(0)
  castTimeFlags        String?
  castDelayFlags       String?
  copyFlags            String?
  removeRequirement    String?
  noNearNpc            Boolean  @default(false)
  additionalRange      Int?
  noNearNpcType        String?
  source               String   @default("rathena")
  sourceHash           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  levels                  SkillLevel[]
  requirements            SkillRequirement[]
  classSkills             ClassSkill[]
  classSkillPrerequisites ClassSkillPrerequisite[]
  units                   SkillUnit[]
  CharacterSkill          CharacterSkill[]

  @@index([type])
  @@index([targetType])
  @@map("skills")
}

// ============================================================
// SKILL LEVEL DATA
// ============================================================

model SkillLevel {
  id String @id @default(uuid())

  skillId Int
  level   Int

  // General combat values
  range    Int?
  hitCount Int?
  element  String?

  splashArea     Int?
  activeInstance Int?
  knockback      Int?
  giveAp         Int?

  // Timing
  castTime           Int?
  afterCastActDelay  Int?
  afterCastWalkDelay Int?

  duration1 Int?
  duration2 Int?

  cooldown      Int?
  fixedCastTime Int?

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, level])
  @@index([skillId])
  @@map("skill_levels")
}

// ============================================================
// SKILL REQUIREMENTS
// ============================================================

model SkillRequirement {
  id String @id @default(uuid())

  skillId Int
  level   Int?

  hpCost Int @default(0)
  spCost Int @default(0)
  apCost Int @default(0)

  hpRateCost Int @default(0)
  spRateCost Int @default(0)
  apRateCost Int @default(0)

  maxHpTrigger Int @default(0)

  zenyCost Int @default(0)

  weapon     String?
  ammo       String?
  ammoAmount Int     @default(0)

  state  String?
  status String?

  spiritSphereCost Int @default(0)

  equipment String?

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  itemCosts SkillRequirementItem[]

  @@unique([skillId, level])
  @@index([skillId])
  @@map("skill_requirements")
}

// ============================================================
// SKILL ITEM COSTS
// ============================================================

model SkillRequirementItem {
  id String @id @default(uuid())

  requirementId String
  itemId        Int

  amount Int @default(1)

  // Null = applies to every skill level
  level Int?

  requirement SkillRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  item        Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([requirementId])
  @@index([itemId])
  @@map("skill_requirement_items")
}

// ============================================================
// SKILL UNITS / GROUND EFFECTS
// ============================================================

model SkillUnit {
  id String @id @default(uuid())

  skillId Int

  unitId      String
  alternateId String?

  layout Int @default(0)
  range  Int @default(0)

  interval Int @default(0)

  target String?
  flags  String?

  status String?

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  levels SkillUnitLevel[]

  @@index([skillId])
  @@map("skill_units")
}

model SkillUnitLevel {
  id String @id @default(uuid())

  skillUnitId String
  level       Int

  layout Int?
  range  Int?

  skillUnit SkillUnit @relation(fields: [skillUnitId], references: [id], onDelete: Cascade)

  @@unique([skillUnitId, level])
  @@map("skill_unit_levels")
}

// ============================================================
// CLASSES / JOBS
// ============================================================

model GameClass {
  id Int @id

  // rAthena job identifier
  aegisName String @unique
  name      String

  // Parent job.
  // Example:
  // Novice -> Swordman -> Knight
  parentId Int?

  // Job hierarchy
  baseJobId Int?
  jobLevel  Int?

  // Custom Heleonaire classification
  heleonaireClass String?

  source     String  @default("rathena")
  sourceHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   GameClass?  @relation("ClassHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children GameClass[] @relation("ClassHierarchy")

  skills     ClassSkill[]
  statGrowth ClassStatGrowth[]
  basePoints ClassBasePoint[]
  aspd       ClassAspd[]

  jobExpGroupId Int?
  jobExpGroup   JobExpGroup? @relation(fields: [jobExpGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  statConfig ClassStatConfig?

  @@index([parentId])
  @@index([heleonaireClass])
  @@index([jobExpGroupId])
  @@map("game_classes")
}

// ============================================================
// CLASS -> SKILL
// ============================================================

model ClassSkill {
  id String @id @default(uuid())

  classId Int
  skillId Int

  maxLevel         Int @default(1)
  requiredJobLevel Int @default(0)

  class GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  skill Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  prerequisites ClassSkillPrerequisite[]

  @@unique([classId, skillId])
  @@index([skillId])
  @@map("class_skills")
}

model ClassSkillPrerequisite {
  id String @id @default(uuid())

  classSkillId    String
  requiredSkillId Int

  requiredLevel Int @default(1)

  classSkill    ClassSkill @relation(fields: [classSkillId], references: [id], onDelete: Cascade)
  requiredSkill Skill      @relation(fields: [requiredSkillId], references: [id], onDelete: Restrict)

  @@unique([classSkillId, requiredSkillId])
  @@index([requiredSkillId])
  @@map("class_skill_prerequisites")
}

// ============================================================
// CHARACTER SKILLS
// ============================================================

model CharacterSkill {
  id String @id @default(uuid())

  characterId String
  skillId     Int

  level Int @default(0)

  // Explicitly learned by player
  learned Boolean @default(false)

  // Hotbar/UI can be handled separately later.
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillId])
  @@index([skillId])
  @@map("character_skills")
}

// ============================================================
// CLASS STAT GROWTH
// ============================================================

model ClassStatGrowth {
  id String @id @default(uuid())

  classId Int
  level   Int

  str Int @default(0)
  agi Int @default(0)
  vit Int @default(0)
  int Int @default(0)
  dex Int @default(0)
  luk Int @default(0)

  gameClass GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, level])
  @@index([classId])
  @@map("class_stat_growth")
}

// ============================================================
// CLASS BASE POINTS
// ============================================================

model ClassBasePoint {
  id String @id @default(uuid())

  classId Int
  level   Int
  points  Int @default(0)

  gameClass GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, level])
  @@map("class_base_points")
}

// ============================================================
// JOBEXPGROUP
// ============================================================

model JobExpGroup {
  id          Int     @id @default(autoincrement())
  sourceKey   String  @unique
  source      String  @default("rathena")
  sourceHash  String?
  maxJobLevel Int

  classes GameClass[]
  entries JobExpEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("job_exp_groups")
}

model JobExpEntry {
  id      Int    @id @default(autoincrement())
  groupId Int
  level   Int
  exp     BigInt

  group JobExpGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([groupId, level])
  @@index([groupId])
  @@map("job_exp_entries")
}

// ============================================================
// CLASS ASPD
// ============================================================

model ClassAspd {
  id String @id @default(uuid())

  classId    Int
  weaponType String

  aspd Int

  gameClass GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, weaponType])
  @@index([classId])
  @@map("class_aspd")
}

// ============================================================
// STATUS EFFECTS
// ============================================================

model StatusEffect {
  id Int @id

  name      String
  aegisName String? @unique

  description String?

  // Status classification
  type String?

  // Default duration / behavior
  duration Int?

  source     String  @default("rathena")
  sourceHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("status_effects")
}

// ============================================================
// ATTRIBUTE / ELEMENT RULES
// ============================================================

model AttributeModifier {
  id String @id @default(uuid())

  attackerElement String
  defenderElement String

  level Int

  modifier Int

  source String @default("rathena")

  @@unique([attackerElement, defenderElement, level])
  @@map("attribute_modifiers")
}

// ============================================================
// SIZE MODIFIERS
// ============================================================

model SizeModifier {
  id String @id @default(uuid())

  weaponType String
  targetSize String

  modifier Int

  source String @default("rathena")

  @@unique([weaponType, targetSize])
  @@map("size_modifiers")
}

// ============================================================
// LEVEL PENALTIES
// ============================================================

model LevelPenalty {
  id String @id @default(uuid())

  levelDifference Int

  penaltyType String
  value       Int

  source String @default("rathena")

  @@index([levelDifference])
  @@map("level_penalties")
}

// ============================================================
// EXPERIENCE TABLES
// ============================================================

model ExpTable {
  id String @id @default(uuid())

  type  String
  level Int

  exp BigInt

  source String @default("rathena")

  @@unique([type, level])
  @@map("exp_tables")
}

// ============================================================
// STAT POINT CURVE
// ============================================================

model StatPointTable {
  id String @id @default(uuid())

  level       Int  @unique
  points      Int
  traitPoints Int?

  source     String  @default("rathena")
  sourceHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stat_point_table")
}

// ============================================================
// ITEM COMBOS
// ============================================================

model ItemCombo {
  id String @id @default(uuid())

  name String?

  script String?

  createdAt DateTime @default(now())

  items ItemComboEntry[]

  @@map("item_combos")
}

model ItemComboEntry {
  id String @id @default(uuid())

  comboId String
  itemId  Int

  combo ItemCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  item  Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([comboId, itemId])
  @@map("item_combo_entries")
}

// ============================================================
// DATA IMPORT TRACKING
// ============================================================

model DataImport {
  id String @id @default(uuid())

  dataset String
  source  String

  sourceVersion String?

  importedAt DateTime @default(now())

  recordsCreated Int @default(0)
  recordsUpdated Int @default(0)
  recordsDeleted Int @default(0)

  success Boolean @default(true)

  errorMessage String?

  @@index([dataset])
  @@index([importedAt])
  @@map("data_imports")
}

// ============================================================
// CLASS STAT CONFIG
// ============================================================

model ClassStatConfig {
  id String @id @default(uuid())

  classId Int @unique

  maxWeight Int?

  hpFactor   Int?
  hpIncrease Int?

  spFactor   Int?
  spIncrease Int?

  apFactor   Int?
  apIncrease Int?

  gameClass GameClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_stat_configs")
}
