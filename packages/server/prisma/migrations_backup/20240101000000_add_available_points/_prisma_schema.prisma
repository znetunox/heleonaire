-- Prisma schema
model Character {
  id            String   @id @default(uuid())
  accountId     String
  name          String   @unique
  class         String
  faction       String
  level         Int      @default(1)
  baseExp       BigInt   @default(0)
  jobExp        BigInt   @default(0)
  hp            Int      @default(100)
  maxHp         Int      @default(100)
  mp            Int      @default(50)
  maxMp         Int      @default(50)
  str           Int      @default(1)
  agi           Int      @default(1)
  vit           Int      @default(1)
  int           Int      @default(1)
  dex           Int      @default(1)
  luk           Int      @default(1)
  availablePoints Int    @default(0)
  mapId         String   @default("plains_of_ash")
  posX          Float    @default(200)
  posY          Float    @default(200)
  gold          BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inventory Inventory[]

  @@map("characters")
}
