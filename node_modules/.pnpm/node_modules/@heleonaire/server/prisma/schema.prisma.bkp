// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id         String   @id @default(uuid())
  username   String   @unique
  email      String   @unique
  password   String   // bcrypt hash
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  characters Character[]

  @@map("accounts")
}

model Character {
  id        String   @id @default(uuid())
  accountId String
  name      String   @unique
  class     String   // knight | assassin | archer | mage | cleric
  faction   String   // heleonaire | darkpact
  level     Int      @default(1)
  baseExp   BigInt   @default(0)
  jobExp    BigInt   @default(0)
  hp        Int      @default(100)
  maxHp     Int      @default(100)
  mp        Int      @default(50)
  maxMp     Int      @default(50)
  // Stats
  str       Int      @default(1)
  agi       Int      @default(1)
  vit       Int      @default(1)
  int       Int      @default(1)
  dex       Int      @default(1)
  luk       Int      @default(1)
  // Points
  availablePoints Int @default(0)
  // Position
  mapId     String   @default("plains_of_ash")
  posX      Float    @default(200)
  posY      Float    @default(200)
  gold      BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inventory Inventory[]

  @@map("characters")
}

model Inventory {
  id          String  @id @default(uuid())
  characterId String
  itemId      Int     // rAthena item ID
  itemName    String
  quantity    Int     @default(1)
  slot        Int     @default(-1) // -1 = bag, 0-15 = equipment slots
  isEquipped  Boolean @default(false)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ─── rAthena Static Data Models ──────────────────────────────────────────────

model Item {
  id              Int      @id @unique      // rAthena item ID (ex: 3010)
  aegisName       String   @unique
  name            String
  type            String
  subType         String?
  buy             Int
  sell             Int
  weight          Float
  attack          Int?
  magicAttack     Int?
  defense         Int?
  range           Int?
  slots            Int?
  weaponLevel     Int?
  armorLevel      Int?
  equipLevelMin   Int?
  refineable      Boolean? @default(false)

  dropEntries DropEntry[]

  @@map("items")
}

model Mob {
  id         Int       @id @unique    // rAthena mob ID (ex: 1001)
  aegisName  String    @unique
  name       String
  level      Int
  hp         Int
  sp         Int
  baseExp    Int
  jobExp     Int
  attack     Int
  attack2    Int
  defense    Int
  magicDefense  Int
  str        Int
  agi        Int
  vit        Int
  int        Int
  dex        Int
  luk        Int
  attackRange  Int
  skillRange   Int
  chaseRange   Int
  size         String
  race         String
  element      String
  elementLevel Int
  walkSpeed    Int
  attackDelay  Int
  attackMotion Int
  damageMotion Int
  ai           String

  dropEntries  DropEntry[]

  @@map("mobs")
}

model DropEntry {
  mobId        Int
  itemId       Int
  rate         Int
  stealProtected Boolean @default(false)

  mob   Mob   @relation(fields: [mobId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([mobId, itemId])
  @@map("mob_drops")
}

